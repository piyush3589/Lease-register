GROQ_API_KEY=
# openai/gpt-oss-120b is the default because it is the smallest hosted model
# that actually honours strict Structured Outputs on Groq: all nine rows, with
# their source quotes, come back in one guaranteed-shape reply.
# gpt-oss-20b accepts the strict request and then returns an EMPTY completion,
# which Groq rejects as json_validate_failed. The app recovers by falling back to
# a looser decoding mode, but that reply is marked `degraded` and may come back
# with fewer than nine rows. Use 120b unless you have a reason not to.
GROQ_MODEL=openai/gpt-oss-120b
EXTRACTOR_API_URL=http://127.0.0.1:8001
# Optional shared secret. If set here it must match the API's value.
EXTRACTOR_API_TOKEN=
# Where the lease register lives. Relative paths resolve against the directory
# you start the API from, so use an absolute path to be safe. This file holds
# real lease data: keep it out of git and out of backups you do not control.
REGISTRY_DB=lease_register.db